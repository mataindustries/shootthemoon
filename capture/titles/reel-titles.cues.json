{
  "schema": "shootthemoon.reel-titles/1",
  "status": "APPROVED — ORBITAL RECORD v1 (championship): Opus treatment primary; Astra's chapter hierarchy as organizing metadata; Astra's closing line as E9.",
  "source": {
    "reel": "reel-57s-1080.mp4 (assembled from capture/finalEdit.json + capture/ci/assembly.ts release overrides)",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "frames": 3456
  },
  "conventions": {
    "frames": "0-based reel frame index at 60 fps. Frame f is shown at f/60 s.",
    "fadeIn": "in {f, fade:n}: element first drawn at frame f; opacity = ease((k+1)/n) for k = frame-f in 0..n-1, then 1.",
    "fadeOut": "out {f, fade:n}: opacity = 1-ease((k+1)/n) for k = frame-f in 0..n-1; not drawn from frame f+n-1 on.",
    "hardOut": "out {f} without fade: not drawn from frame f on (use when the exit coincides with a picture cut).",
    "track": "letter-spacing in em, interpolated from 'from' to 'to' over n frames starting at f, eased.",
    "draw": "rule/hairline scaleX 0 -> 1 over n frames from f, eased, from its 'origin' end.",
    "text": "a string, or [[frame, string], ...] swaps: each string is shown from its frame until the next swap.",
    "counter": "{token} in text is replaced by v = v0 + (v1-v0)*(frame-f0)/(f1-f0), clamped to [min(v0,v1), max(v0,v1)], floored to 0.01, formatted SS.hh (two-digit seconds, two-digit hundredths).",
    "positions": "x and y are 1920x1080 pixels. For text, y is the BASELINE; for rule, chip, segmentRule and hairline, y is the TOP edge. anchor 'start' = left edge of the first glyph at x; 'middle' = visual centre at x (compensate the trailing letter-spacing).",
    "ease": "out = cubic-bezier(0.22, 1, 0.36, 1); inOut = cubic-bezier(0.65, 0, 0.35, 1); linear = linear. Default ease for fades/track/draw is out.",
    "plateMoves": "Each plateMove scales the CLEAN reel picture of frames [from..to] about anchor by s(f) = scale[0] + (scale[1]-scale[0])*(f-from)/(to-from). Sub-pixel accurate (see MOTION_TREATMENT.md, implementation spec). Titles are composited after plate moves; brackets with followsPlate apply the same transform to their box.",
    "chapter": "Astra's narrative hierarchy (ARRIVAL, CONTACT, OFFENSIVE, DEFENSE, TERRITORY), in that order. Organizing metadata for the system and for later music sync only: it is never drawn. Each chapter is named once, in order; events without one (the closing statement, the end card) sit outside it."
  },
  "tempo": {
    "bpm": 100,
    "framesPerBar": 144,
    "framesPerBeat": 36,
    "framesPerGrid": 18,
    "framesPerUnit": 9,
    "rule": "Every event starts on an 18-frame grid line (the edit's own 300 ms grid). Internal staggers are multiples of 9 frames. Exits end on a picture cut or immediately before a flash/dip."
  },
  "chapters": [
